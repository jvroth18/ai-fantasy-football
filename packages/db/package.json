{
  "name": "@ai-ff/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external better-sqlite3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-ff/data": "workspace:*",
    "@ai-ff/domain": "workspace:*",
    "better-sqlite3": "latest",
    "drizzle-orm": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest"
  }
}
